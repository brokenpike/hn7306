# Settings specific to this machine (Dell Latitude 5400, i5-8350U, 16 GiB
# RAM). A thin client: no local LLM server, no VM tooling, light on storage.
# Its job is SSH and a GNOME Remote Desktop/RDP client into hn7306 or gz302
# for anything that needs real compute.
{ pkgs, ... }:

{
  imports = [
    ./hardware-configuration.nix # generated by nixos-generate-config, do not edit
  ];

  # Must match the nixosConfigurations attribute name in flake.nix.
  networking.hostName = "latitude5400";

  # Tailscale SSH, as on hn7306 and gz302: logins over the tailnet use the
  # Tailscale identity instead of keys or passwords. OpenSSH (configuration.nix)
  # still serves the LAN as a backup.
  services.tailscale.extraSetFlags = [ "--ssh" ];

  # Keyboard layout (US), matching what the installer already set.
  services.xserver.xkb = {
    layout = "us";
    variant = "";
  };
  console.keyMap = "us";

  # RDP/VNC client to reach hn7306/gz302's desktops. No local LLM server or VM
  # tooling: this host leans on the other two for anything heavier.
  environment.systemPackages = with pkgs; [
    remmina
  ];

  # Installed with NixOS 26.05. Do not bump this when upgrading; see
  # configuration.nix(5) before changing it.
  system.stateVersion = "26.05";
}
