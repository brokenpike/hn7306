# Settings specific to this machine (ASUS ROG Flow Z13 GZ302EA).
{ inputs, ... }:

let
  btrfsOptions = [
    "compress=zstd:3"
    "noatime"
  ];
in
{
  imports = [
    # nixos-hardware has no GZ302 profile (only the GV302X and GZ301VU Flows),
    # so take the generic modules its Flow profiles are built from.
    inputs.nixos-hardware.nixosModules.common-cpu-amd
    inputs.nixos-hardware.nixosModules.common-cpu-amd-pstate
    inputs.nixos-hardware.nixosModules.common-gpu-amd
    inputs.nixos-hardware.nixosModules.common-pc-laptop
    inputs.nixos-hardware.nixosModules.common-pc-ssd
    inputs.nixos-hardware.nixosModules.asus-battery
    ./hardware-configuration.nix # generated by nixos-generate-config, do not edit
    ./strix-halo.nix
    ./llama-swap.nix
    ./open-webui.nix
    ../../hermes.nix
  ];

  # Must match the nixosConfigurations attribute name in flake.nix.
  networking.hostName = "gz302";

  # Keyboard layout for gz302 (Norwegian)
  services.xserver.xkb = {
    layout = "no,us";
    variant = "";
  };
  console.keyMap = "no";

  # Written at boot and after suspend, as on hn7306. asusd also keeps a limit
  # (100 in /etc/asusd/asusd.ron), but it is state, not config.
  hardware.asus.battery.chargeUpto = 80;

  # Tailscale SSH, as on hn7306: it was switched on by hand, this keeps it
  # across a reset of Tailscale's settings. OpenSSH keys (configuration.nix)
  # are the backup over the LAN.
  services.tailscale.extraSetFlags = [ "--ssh" ];

  # The home LLM server on the tailnet. The names are llama-swap model IDs,
  # defined in llama-swap.nix; both stay loaded, so switching between Hermes
  # and OpenCode reloads nothing.
  local.llm = {
    baseURL = "http://127.0.0.1:8080/v1";
    model = "qwen3.6-35b";
    opencode.model = "qwen3-coder-30b";
    # Runs alone; switching to it unloads the pair (llama-swap.nix).
    extraModels = [ "qwen3.8-flash-next" ];
  };

  # A tablet: the accelerometer lets GNOME rotate the screen.
  hardware.sensor.iio.enable = true;

  # The installer created the subvolumes without mount options. Compression
  # only applies to files written after the switch.
  fileSystems = {
    "/".options = btrfsOptions;
    "/home".options = btrfsOptions;
    "/nix".options = btrfsOptions;
  };

  # Installed with NixOS 26.05. Do not bump this when upgrading; see
  # configuration.nix(5) before changing it.
  system.stateVersion = "26.05";
}
